            events.append(event)
        previous = [copy.deepcopy(row) for row in context.get("previous_sessions", []) if isinstance(row, dict) and _known(row, as_of)]
        filtered_future_previous_news = 0
        for day in previous:
            groups = day.get("groups")
            if not isinstance(groups, dict):
